import { createFileRoute, Outlet, redirect } from "@tanstack/react-router";
import { useQuery } from "convex/react";
import { api } from "@cvx/_generated/api";
import { Loader2 } from "lucide-react";

export const Route = createFileRoute("/_app/_auth/admin/_layout")({
  beforeLoad: async ({ context }) => {
    // Note: context.user is populated by the parent _app.tsx or _auth.tsx
    // But we need to verify isAdmin status.
    // TanStack Router context can be used here.
  },
  component: AdminLayout,
});

function AdminLayout() {
  const user = useQuery(api.app.getCurrentUser);

  if (user === undefined) {
    return (
      <div className="flex h-screen w-full items-center justify-center">
        <Loader2 className="h-8 w-8 animate-spin text-primary" />
      </div>
    );
  }

  if (!user || !user.isAdmin) {
    throw redirect({ to: "/dashboard" });
  }

  return (
    <div className="flex h-full w-full flex-col">
      <header className="flex h-16 items-center border-b px-6 bg-card">
        <h1 className="text-xl font-bold">Admin Panel</h1>
      </header>
      <main className="flex-1 p-6">
        <Outlet />
      </main>
    </div>
  );
}
