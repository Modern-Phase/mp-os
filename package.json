{
  "name": "convex-saas",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "npm run dev",
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:frontend": "vite",
    "dev:backend": "convex dev",
    "predev": "convex dev --run init --until-success",
    "build": "tsc -b && vite build",
    "lint": "eslint . --ignore-pattern convex/_generated --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json && tsc -p convex/tsconfig.json",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:all": "npm run test:run && npm run test:e2e"
  },
  "dependencies": {
    "@auth/core": "^0.37.4",
    "@aws-sdk/client-s3": "^3.983.0",
    "@aws-sdk/s3-request-presigner": "^3.983.0",
    "@clerk/clerk-react": "^5.60.0",
    "@convex-dev/react-query": "^0.0.0-alpha.3",
    "@epic-web/client-hints": "^1.3.2",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@react-email/components": "0.0.22",
    "@tanstack/ai": "^0.2.2",
    "@tanstack/ai-openai": "^0.3.0",
    "@tanstack/ai-openrouter": "^0.3.0",
    "@tanstack/ai-react": "^0.2.2",
    "@tanstack/react-form": "0.26.4",
    "@tanstack/react-query": "^5.51.15",
    "@tanstack/react-router": "^1.45.11",
    "@types/papaparse": "^5.5.2",
    "@xixixao/uploadstuff": "^0.0.5",
    "class-variance-authority": "^0.7.0",
    "convex": "^1.31.7",
    "convex-helpers": "^0.1.50",
    "cookie": "^0.6.0",
    "i18next": "^23.12.2",
    "i18next-browser-languagedetector": "^8.0.0",
    "i18next-http-backend": "^2.5.2",
    "lucide-react": "^0.416.0",
    "npm-run-all": "^4.1.5",
    "openai": "^6.17.0",
    "oslo": "^1.2.1",
    "papaparse": "^5.5.3",
    "pdf2json": "^4.0.2",
    "posthog-js": "^1.345.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.4.0",
    "react-helmet-async": "^2.0.5",
    "react-i18next": "^15.0.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.7.0",
    "remark-gfm": "^4.0.1",
    "resend": "^3.2.0",
    "stripe": "^16.6.0",
    "tailwind-merge": "^2.4.0",
    "tailwindcss-animate": "^1.0.7",
    "unpdf": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@playwright/test": "^1.58.1",
    "@tanstack/router-devtools": "^1.45.11",
    "@tanstack/router-plugin": "^1.45.8",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/cookie": "^0.6.0",
    "@types/eslint__js": "^8.42.3",
    "@types/node": "^20.14.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^7.15.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/ui": "^4.0.18",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "happy-dom": "^20.5.0",
    "playwright": "^1.58.1",
    "postcss": "^8.4.40",
    "prettier": "3.3.3",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "typescript-eslint": "^7.17.0",
    "vite": "^5.3.4",
    "vitest": "^4.0.18"
  }
}
