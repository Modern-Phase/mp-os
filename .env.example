# ===================================================================
# Clerk Authentication
# ===================================================================
# Get your publishable key from https://dashboard.clerk.com
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key

# ===================================================================
# PostHog Analytics
# ===================================================================
# Get your project API key from https://us.posthog.com/settings/project
# (Settings > Project > Project API Key)
VITE_POSTHOG_KEY=phc_your-posthog-project-api-key

# PostHog ingest host (defaults to https://us.i.posthog.com if omitted)
# Use https://eu.i.posthog.com for EU Cloud
# VITE_POSTHOG_HOST=https://us.i.posthog.com

# ===================================================================
# Convex Configuration
# ===================================================================
# These are automatically set when you run: npx convex dev
# CONVEX_DEPLOYMENT=dev:your-deployment-name
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# ===================================================================
# Convex Backend Environment Variables
# Set these via: npx convex env set KEY VALUE
# ===================================================================

# Clerk JWT issuer domain (from Clerk Dashboard > API Keys)
# CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-domain.clerk.accounts.dev

# Stripe secret key (from https://dashboard.stripe.com/apikeys)
# STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key

# Stripe webhook secret (from Stripe Dashboard > Webhooks)
# STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Your app URL (used for Stripe redirects)
# SITE_URL=http://localhost:5173

# Resend API key for transactional emails (from https://resend.com/api-keys)
# AUTH_RESEND_KEY=re_your-resend-api-key

# From email for transactional emails
# AUTH_EMAIL=Your App <noreply@yourdomain.com>

# ===================================================================
# AI Configuration (set via npx convex env set)
# ===================================================================
# Open Router API key (for multi-LLM chat via https://openrouter.ai)
# OPEN_ROUTER=sk-or-v1-your-openrouter-api-key

# Helicone API key (for LLM observability; optional)
# HELICONE_API_KEY=your-helicone-api-key

# OpenAI API key (from https://platform.openai.com/api-keys)
# OPENAI_API_KEY=sk-your-openai-api-key

# OpenAI model (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini
